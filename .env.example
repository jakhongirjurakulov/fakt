# Локальная разработка. Скопируйте в .env: cp .env.example .env
# Значения ниже — только для своей машины. Настоящие ключи и пароли сюда не пишем.

# PostgreSQL (docker compose)
POSTGRES_USER=fakt
POSTGRES_PASSWORD=fakt_dev
POSTGRES_DB=fakt
POSTGRES_PORT=5432

# S3-хранилище для фото и актов (SeaweedFS в docker compose)
S3_ACCESS_KEY=fakt_dev
S3_SECRET_KEY=fakt_dev_secret
S3_BUCKET=fakt
S3_PORT=8333

# API
API_PORT=3000
DATABASE_URL=postgres://fakt:fakt_dev@localhost:5432/fakt
S3_ENDPOINT=http://localhost:8333
LOG_LEVEL=info
