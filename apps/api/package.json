{
  "name": "@fakt/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts latest",
    "db:rollback": "tsx --env-file-if-exists=../../.env src/db/migrate.ts down",
    "db:types": "kysely-codegen --env-file ../../.env --dialect postgres --type-mapping \"{\\\"int8\\\":\\\"number\\\"}\" --numeric-parser number --date-parser string --exclude-pattern \"kysely_*\" --out-file src/db/types.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "fastify": "^5.12.8",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
